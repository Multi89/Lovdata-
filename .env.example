# Local SQLite index built from Lovdata's public API datasets.
LOVDATA_DB_PATH=./data/lovdata.sqlite3

# Official public-data service.
LOVDATA_PUBLIC_API_BASE_URL=https://api.lovdata.no

# Default: all current Norwegian laws and central regulations. Use "all" for every dataset.
LOVDATA_DATASET_FILTER=gjeldende-lover,gjeldende-sentrale-forskrifter

# Protect the GPT Actions API with a long random Bearer token.
LOVDATA_ACTIONS_API_KEY=replace-with-a-long-random-secret

# Optional approved Lovdata Pro integration.
# Do NOT place a Lovdata username, password, browser cookie, or session token here.
# This must point to an API/gateway that Lovdata has approved for automated use.
LOVDATA_PRO_GATEWAY_URL=
LOVDATA_PRO_GATEWAY_TOKEN=
LOVDATA_PRO_SEARCH_PATH=/v1/search
LOVDATA_PRO_DOCUMENT_PATH=/v1/documents/{document_id}

# Server mode: actions for a mobile-usable Custom GPT, mcp for a ChatGPT developer app.
LOVDATA_SERVER_MODE=actions
MCP_HOST=0.0.0.0
MCP_PORT=8000
